{
  "realm": "demo-realm",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "user", "description": "Standard authenticated user" },
      { "name": "admin", "description": "Administrator" }
    ]
  },
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Anderson",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "alice123", "temporary": false }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Baker",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "bob123", "temporary": false }
      ],
      "realmRoles": ["admin", "user"]
    }
  ],
  "clients": [
    {
      "clientId": "webapi-client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:5000/*", "http://localhost:5173/*"],
      "webOrigins": ["*"]
    }
  ]
}
